# Drizzle
DATABASE_URL="mysql://root:mysecretpassword@localhost:3306/local"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Secret required (as ?secret= or Authorization: Bearer) to hit /api/cron/* endpoints
CRON_SECRET=""

# ── Google OAuth (Better Auth social provider) ──
CLIENTID=""
CLIENTSECRET=""
# Same client id, exposed to the browser for Google One Tap
PUBLIC_CLIENTID=""

# ── Stripe ──
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Email (nodemailer SMTP) ──
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""

# Directory uploads are written to
FILES_DIR=""

# ── Delivery route planner ──
# Where the van starts and ends its Saturday circuit. Any valid UK postcode.
DEPOT_POSTCODE="N17 8AA"
# OpenRouteService key, for real driving times on the route planner.
# Free tier at https://openrouteservice.org/dev/#/signup (500 matrix requests/day).
# Optional: without it the planner still orders stops, using straight-line estimates.
ORS_API_KEY=""

# ── Web push notifications ──
# Generate a pair with: npx web-push generate-vapid-keys
PUBLIC_VAPID_KEY=""
VAPID_PRIVATE_KEY=""
# Contact the push services can reach you at (mailto: or https: URL)
VAPID_SUBJECT="mailto:hello@gotera.co.uk"
